#!/usr/bin/env bash
# Parser regression gate.
#
# Blocks any commit in which a parser change makes something worse on the two
# answer keys (scripts/answer_key.py): a generated-script unit or a hand-labelled
# real line that was read by the right voice and no longer is. Runs ONLY when
# parser-relevant files are staged, so ordinary commits are not slowed down.
# (Replaced the old scorecard gate in Oct 2026: its "ground truth" was made by
# rules and it could see only about half of each script.)
#
# Installed via:  git config core.hooksPath scripts/git-hooks
# (re-run that once after cloning; see CLAUDE.md "Parser change protocol").
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# Gate only changes that can affect parser output.
if ! git diff --cached --name-only | grep -qE '^backend/parser\.py$|^backend/corrections_config\.json$'; then
    exit 0
fi

# Resolve a Python that has the deps (prefer the dev venv).
PYTHON=""
for c in .venv/bin/python3 .venv/bin/python vendor/python/bin/python3 python3; do
    if [ -x "$c" ] 2>/dev/null || command -v "$c" &>/dev/null; then PYTHON="$c"; break; fi
done
if [ -z "$PYTHON" ]; then
    echo "[pre-commit] No Python found — skipping the answer-key gate." >&2
    exit 0
fi

echo "[pre-commit] parser changed — checking both answer keys (~1–2 min)…"
if "$PYTHON" scripts/answer_key.py --check; then
    exit 0
fi

cat >&2 <<'EOF'

──────────────────────────────────────────────────────────────────────────────
✗ Commit blocked: something that was read by the right voice no longer is.
  The lines/units are listed above.

  • If it's a bug:  fix it, then re-run `python scripts/answer_key.py`.
  • If it's a deliberate, reviewed trade-off, accept it:
        python scripts/answer_key.py --save
        python scripts/generate_reference.py <ChangedName>   # refresh "what changed" baselines
        git add "Test PDFs/reference/" && commit again
  • To bypass once (not recommended):  git commit --no-verify
──────────────────────────────────────────────────────────────────────────────
EOF
exit 1
